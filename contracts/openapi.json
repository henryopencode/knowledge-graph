        "required": [
          "id",
          "locale",
          "title",
          "description",
          "slug",
          "category",
          "tags",
          "date",
          "reading_minutes",
          "html",
          "revision",
          "translations",
          "content_locale",
          "available_locales"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
